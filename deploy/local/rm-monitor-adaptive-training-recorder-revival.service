[Unit]
Description=RM Monitor revival adaptive training recorder (2026-07-31)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=maverick
Group=maverick
WorkingDirectory=/home/maverick/RM/rm-monitor-2026
Environment=HOME=/home/maverick
Environment=PYTHONUNBUFFERED=1
Environment=RM_MONITOR_SERVICE_NAME=adaptive-training-recorder-revival
EnvironmentFile=/home/maverick/RM/rm-monitor-2026/deploy/local/rm-monitor-event.conf
ExecStart=/usr/bin/python3 /home/maverick/RM/rm-monitor-2026/deploy/local/adaptive_training_recorder.py --event ${RM_MONITOR_EVENT_NAME} --zone ${RM_MONITOR_REVIVAL_ZONE} --date 2026-07-31 --timezone Asia/Taipei --res high --source-root /mnt/PC801/rm-monitor/adaptive-training --target-root /mnt/server_data/rm-monitor/records --segment-time 3600 --settle-seconds 180 --poll-seconds 30 --stop-at 2026-08-01T00:00:00+08:00 --lock-file /home/maverick/RM/rm-monitor-2026/logs/adaptive-training-recorder-revival-2026-07-31.lock
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=120
