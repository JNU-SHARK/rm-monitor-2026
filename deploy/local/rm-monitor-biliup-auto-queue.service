[Unit]
Description=RM Monitor Bilibili auto queue
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
User=maverick
Group=maverick
WorkingDirectory=/home/maverick/RM/rm-monitor-2026
Environment=HOME=/home/maverick
Environment=KUBECONFIG=/home/maverick/.kube/config
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 deploy/local/biliup_auto_queue.py --zone 北部赛区 --start-order 1 --limit 7 --season-name RMUC2026北部赛区全视角录制 --season-id 8209772 --section-id 9124491 --biliup deploy/local/biliup_direct_docker.sh --cookie /home/maverick/RM/rm-monitor-2026/cookies.json --poll-seconds 60
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
