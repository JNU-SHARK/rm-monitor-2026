[Unit]
Description=RM Monitor revival adaptive training Bilibili upload queue (2026-07-31)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
User=maverick
Group=maverick
WorkingDirectory=/home/maverick/RM/rm-monitor-2026
Environment=HOME=/home/maverick
Environment=PYTHONUNBUFFERED=1
Environment=RM_MONITOR_SERVICE_NAME=adaptive-training-upload-revival
EnvironmentFile=/home/maverick/RM/rm-monitor-2026/deploy/local/rm-monitor-event.conf
ExecStart=/usr/bin/python3 /home/maverick/RM/rm-monitor-2026/deploy/local/adaptive_training_upload_queue.py --event ${RM_MONITOR_EVENT_NAME} --zone ${RM_MONITOR_REVIVAL_ZONE} --date 2026-07-31 --timezone Asia/Taipei --target-root /mnt/server_data/rm-monitor/records --state-file /home/maverick/RM/rm-monitor-2026/logs/adaptive-training-upload-state-2026-07-31-revival.json --upload-lock-file /home/maverick/RM/rm-monitor-2026/logs/biliup-upload-global.lock --biliup /home/maverick/RM/rm-monitor-2026/deploy/local/biliup_direct_docker.sh --cookie /home/maverick/RM/rm-monitor-2026/cookies.json --is-only-self 0 --season-name ${RM_MONITOR_REVIVAL_BILI_SEASON_NAME} --season-id ${RM_MONITOR_REVIVAL_BILI_SEASON_ID} --section-id ${RM_MONITOR_REVIVAL_BILI_SECTION_ID} --poll-seconds 300 --settle-seconds 300 --hour-delay-seconds 600 --retry-seconds 1800 --stop-at 2026-08-02T06:00:00+08:00 --submit
Restart=on-failure
RestartSec=60
TimeoutStopSec=120
